generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  MAINTAINER
  MANAGER
  FINANCE
  LOGISTICS
  SUPERVISOR
  VIEWER
}

enum AccessLevel {
  FULL
  READ_WRITE
  READ_ONLY
}

enum Company {
  UFP
  SYNERGY
}

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  passwordHash    String
  role            UserRole    @default(MANAGER)
  accessLevel     AccessLevel @default(READ_ONLY)
  restrictedPages String[]    @default([])
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdById     String?
  createdBy       User?       @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers       User[]             @relation("UserCreatedBy")
  poHistory          PoHistory[]
  priceListVersions  PriceListVersion[]
}

model PurchaseOrder {
  id                Int         @id @default(autoincrement())
  company           Company     @default(UFP)
  siNo              Int?
  poNo              String
  rev               Int         @default(0)
  concat            String?
  status            String      @default("PO Received")
  poDate            String?
  active            Boolean     @default(true)
  skids             Float?
  stockingLocation  String?
  portOfDest        String?
  poValue           Float?
  /// Total printed on the customer PO — kept only to flag pricing that disagrees with our table
  custPoTotal       Float?
  /// Gross invoice value (m² / Ext Inv based)
  grossInvoiceValue Float?
  /// Standard (default) or High
  priority          String      @default("Standard")
  totalM2           Float?
  productionSite    String?
  productionStart   String?
  productionEtc     String?
  piNo              String?
  piDate            String?
  poToPi            Int?
  piValue           Float?
  piApprovedDate    String?
  piResubmitCount   Int         @default(0)
  piRejectedNote    String?
  dpDate            String?
  piToDp            Int?
  dpAmount          Float?
  shippingEta       String?
  bol               String?
  isf               String?
  containerNo       String?
  shippingLine      String?
  shippingUrl       String?
  actualDeparture   String?
  dpToShip          Int?
  ciNo              String?
  ciDate            String?
  ciApprovedDate    String?
  ciResubmitCount   Int         @default(0)
  ciRejectedNote    String?
  revisionSent      String?
  freight           Float?
  inland            Float?
  ciValue           Float?
  balanceDue        Float?
  bpDate            String?
  ciToBp            Int?
  bpAmount          Float?
  telexDate         String?
  bpToTelex         Int?
  arrivalDate       String?
  planningDate      String?
  notes             String?
  soNo                 String?
  standardColorsOnly   String?
  allMaterialAvailable String?
  productionBegin      String?
  productionComplete   String?
  dispatchFromFactory  String?
  piSent               String?
  /// Manual / drag-drop order within priority (lower = sooner)
  productionSequence   Int?
  productionStatus     String?
  productionNotes      String?
  stockingEmailSentAt  String?
  lines             PoLine[]
  history           PoHistory[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([poNo])
  @@index([status])
  @@index([company])
}

model PoLine {
  id         Int           @id @default(autoincrement())
  poId       Int
  po         PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  lineNo     Int
  partNo     String?
  custPartNo String?
  size       String?
  widthMm    Float?
  lengthMm   Float?
  color      String?
  qtyMsf     Float?
  qtyM2      Float?
  sheets     Float?
  skids      Float?
  unitMsf    Float?
  unitM2     Float?
  /// Cynergy quotes per sheet rather than per MSF
  unitSheet  Float?
  extPo      Float?
  extInv     Float?
  /// $/MSF printed on the customer PO (our price list stays authoritative — see unitMsf)
  custUnitMsf Float?
  /// Line amount printed on the customer PO
  custExtPo   Float?
  notes           String?
  /// Date used to look up the price (usually PO date)
  priceAsOf       String?
  /// Effective-from of the ProductPrice row applied to this line
  priceEffectiveFrom String?
  actualQtyM2     Float?
  actualSheets    Float?
  actualSkids     Float?
  actualNotes     String?
}

// ---------- Reference / master data (per-company: UFP and Cynergy are kept separate) ----------

model ProcessStage {
  id      Int     @id @default(autoincrement())
  company Company @default(UFP)
  order   Int
  name    String

  @@unique([company, order])
  @@unique([company, name])
}

model Port {
  id          Int     @id @default(autoincrement())
  company     Company @default(UFP)
  name        String
  sailingDays Int?
  freight     Float?
  inland      Float?

  @@unique([company, name])
}

model StockingLocation {
  id          Int     @id @default(autoincrement())
  company     Company @default(UFP)
  name        String
  arrivalPort String?
  email       String?

  @@unique([company, name])
}

model ShippingLine {
  id          Int     @id @default(autoincrement())
  company     Company @default(UFP)
  name        String
  trackingUrl String?

  @@unique([company, name])
}

model Color {
  id         Int     @id @default(autoincrement())
  company    Company @default(UFP)
  /// Vendor colour code, e.g. ASC 0096
  code       String
  /// Vendor colour name, e.g. GLOSSY BLACK
  name       String?
  /// Cynergy's own short name for the colour, e.g. BLACK. Cynergy POs reference this.
  shortName  String?
  /// ACM (Cynergy) / ACP (UFP)
  construction String?
  isStandard Boolean @default(false)

  @@unique([company, code])
}

model Product {
  id              Int     @id @default(autoincrement())
  company         Company @default(UFP)
  /// Key used by this company's price sheet: UFP = Product Code 1 (704984);
  /// Cynergy = Full Item Description (2MM ACM 49" x 96" ASC 0069 GLOSSY WHITE),
  /// because most Cynergy items have no product code at all.
  partNo          String
  custPartNo      String?
  /// Cynergy Product Code 1 — optional, only ~1/3 of Cynergy items carry one.
  vendorPartNo    String?
  itemType        String?
  surface         String?
  construction    String?
  thickness       String?
  widthIn         Float?
  widthMm         Float?
  lengthIn        Float?
  lengthMm        Float?
  description     String?
  colorName       String?
  vendorColorCode String?
  /// Cynergy Color (short name, e.g. BLACK) — how Cynergy POs identify colour.
  shortColorName  String?
  /// Current open price (denormalized from latest ProductPrice for fast lookup)
  pricePerSqft    Float?
  pricePerM2      Float?
  pricePerMsq     Float?
  pricePerSheet   Float?
  effectiveFrom   String?
  effectiveTo     String?
  prices          ProductPrice[]

  @@unique([company, partNo])
  @@index([company])
}

/// Named pricing table apply (Excel upload). Live = current open list; Past = superseded/historical.
enum PriceListStatus {
  LIVE
  PAST
}

model PriceListVersion {
  id            Int             @id @default(autoincrement())
  company       Company         @default(UFP)
  label         String
  /// Inclusive start for this table (YYYY-MM-DD)
  effectiveFrom String
  /// Inclusive end. Null while LIVE / open-ended.
  effectiveTo   String?
  status        PriceListStatus @default(LIVE)
  sourceSheet   String?
  sourceFile    String?
  note          String?
  createdAt     DateTime        @default(now())
  createdById   String?
  createdBy     User?           @relation(fields: [createdById], references: [id])
  prices        ProductPrice[]

  @@index([company, status, effectiveFrom])
}

/// Dated price versions — updating price creates a new row; old POs keep stamped line rates.
model ProductPrice {
  id            Int      @id @default(autoincrement())
  productId     Int
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceListVersionId Int?
  priceListVersion   PriceListVersion? @relation(fields: [priceListVersionId], references: [id], onDelete: SetNull)
  pricePerSqft  Float?
  pricePerM2    Float?
  pricePerMsq   Float?
  pricePerSheet Float?
  /// Inclusive start (YYYY-MM-DD)
  effectiveFrom String
  /// Inclusive end (YYYY-MM-DD). Null = current / open-ended.
  effectiveTo   String?
  createdAt     DateTime @default(now())

  @@index([productId, effectiveFrom])
  @@index([priceListVersionId])
}

model CapacityPeriod {
  id                  Int     @id @default(autoincrement())
  company             Company @default(UFP)
  /// Inclusive start (YYYY-MM-DD)
  effectiveFrom       String
  /// Inclusive end (YYYY-MM-DD). Null = current / open-ended.
  effectiveTo         String?
  label               String?
  productionLines     Int     @default(2)
  m2PerLinePerDay     Float   @default(3000)
  m2PerContainer      Float   @default(8300)
  workingDaysPerMonth Int     @default(26)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([company, effectiveFrom])
}

model AppConfig {
  id                  Int     @id @default(autoincrement())
  company             Company @unique @default(UFP)
  sheetsPerSkid       Int?
  downpaymentPct      Float?
  /// Days after commercial invoice that the balance is due (Cynergy = 10).
  finalPaymentDays    Int?
  containerMaxM2      Float?
  leadTimeStandard    Int?
  leadTimeNonStandard Int?
  /// Payment variance allowed before a DP / balance payment is flagged.
  paymentTolerancePct Float?  @default(0.01)
  paymentToleranceAbs Float?  @default(1)
  originPort          String?
  pricingNote         String?
  productionLines     Int?    @default(2)
  m2PerLinePerDay     Float?  @default(3000)
  m2PerContainer      Float?  @default(8300)
  workingDaysPerMonth Int?    @default(26)
}

model PoHistory {
  id        Int           @id @default(autoincrement())
  poId      Int
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  stage     String
  note      String?
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  byRole    String?
  at        String
  createdAt DateTime      @default(now())
}

model AppSettings {
  id        Int      @id @default(autoincrement())
  company   Company  @unique
  master    Json
  pricing   Json
  updatedAt DateTime @updatedAt
}

/// Staging inbox for Cynergy web-form PO entries (owned by cynergyform app; Tracker imports from here).
enum CynergySubmissionStatus {
  PENDING
  REJECTED
  IMPORTED
}

model CynergyFormSubmission {
  id               Int                     @id @default(autoincrement())
  status           CynergySubmissionStatus @default(PENDING)
  poNo             String
  poDate           String?
  stockingLocation String?
  portOfDest       String?
  notes            String?
  submitterName    String?
  submitterEmail   String?
  submitterPhone   String?
  lines            Json
  rejectReason     String?
  reviewedById     String?
  reviewedAt       DateTime?
  importedPoId     Int?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([status])
  @@index([poNo])
  @@index([createdAt])
}
